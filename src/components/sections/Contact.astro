---
import ContactForm from "../react/ContactForm.tsx";
import { Utensils, GlassWater, ChefHat, Sparkles } from "lucide-react";

const badges = [
  { icon: Utensils, text: "COCINA DE ORIGEN" },
  { icon: GlassWater, text: "BARRA DE AUTOR" },
  { icon: ChefHat, text: "EQUIPO EXPERTO" },
];
---

<section
  id="contacto"
  class="relative py-16 md:py-32 bg-surface-100 overflow-hidden"
>
  <div class="container relative z-10 mx-auto px-6 md:px-12">
    <!-- HEADER BLOCK: EDITORIAL FLOW -->
    <div class="mb-16 md:mb-24 animate-reveal text-center">
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="h-px w-12 bg-primary"></div>
        <span class="text-primary text-xs font-bold uppercase tracking-[0.5em]">
          CONTACTO DIRECTO
        </span>
        <div class="h-px w-12 bg-primary"></div>
      </div>

      <h2
        class="text-5xl md:text-7xl lg:text-8xl font-heading text-surface-800 leading-[1.1] uppercase tracking-tighter mb-8"
      >
        HAGAMOS SU MESA <br />
        <span class="text-primary">UNA REALIDAD.</span>
      </h2>

      <div class="max-w-xl mx-auto">
        <p
          class="text-secondary/60 text-base md:text-lg font-body leading-relaxed uppercase tracking-wider text-[14px]"
        >
          NUESTRO EQUIPO DE RECEPCIÓN ESTÁ LISTO PARA COORDINAR CADA DETALLE DE
          SU PRÓXIMA EXPERIENCIA EN NUESTRO SALÓN.
        </p>
      </div>
    </div>

    <!-- FORM BLOCK: CRISTALERÍA GOURMET -->
    <div
      class="relative max-w-4xl mx-auto mb-20 animate-reveal [animation-delay:200ms]"
    >
      <div class="absolute -inset-4 bg-primary/5 rounded-[4rem] blur-2xl -z-10">
      </div>
      <ContactForm client:visible />
    </div>
  </div>
</section>

<style>
  .animate-reveal {
    opacity: 0;
    transform: translateY(30px);
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
