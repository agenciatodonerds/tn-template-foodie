---
import { Star, Quote, MessageCircle, Utensils, CalendarCheck } from "lucide-react";

const testimonials = [
  {
    name: "CARLOS RODRÍGUEZ",
    experience: "EXPERIENCIA NOCTURNA",
    dish: "Ojo de Bife Madurado",
    text: "LA CALIDAD DE LA CARNE ES SUPERIOR A CUALQUIER OTRO LUGAR EN LA CIUDAD. EL PUNTO DE COCCIÓN FUE EXACTO Y LA ATENCIÓN DEL SOMMELIER HIZO QUE LA CENA FUERA PERFECTA.",
    rating: 5
  },
  {
    name: "ELENA SANTILLÁN",
    experience: "CENA DE NEGOCIOS",
    dish: "Degustación de Pasos",
    text: "UN AMBIENTE SOFISTICADO Y TRANQUILO. IDEAL PARA REUNIONES DONDE SE BUSCA PRIVACIDAD Y UNA GASTRONOMÍA DE ALTO NIVEL. LA PRESENTACIÓN DE LOS PLATOS ES UNA OBRA DE ARTE.",
    rating: 5
  },
  {
    name: "MARCELO GÓMEZ",
    experience: "ANIVERSARIO",
    dish: "Coctelería de Autor",
    text: "NOS SORPRENDIERON CON UN TRAGO PERSONALIZADO. CUIDAN CADA DETALLE DESDE QUE LLEGAS HASTA QUE TE VAS. SIN DUDA, EL MEJOR RESTAURANTE GOURMET DEL DISTRITO.",
    rating: 5
  }
];
---

<section id="reservas" class="relative py-16 md:py-28 bg-surface-800 overflow-hidden">
  <div class="container relative z-10 mx-auto px-6 md:px-12">
    
    <!-- HEADER BLOCK: ESTILO EDITORIAL LIMPIO -->
    <div class="mb-16 md:mb-24 animate-reveal text-center lg:text-left">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-12">
        <div class="max-w-3xl">
          <div class="flex items-center justify-center lg:justify-start gap-4 mb-6">
            <div class="h-px w-12 bg-primary"></div>
            <span class="text-primary text-xs font-bold uppercase tracking-[0.4em]">
              Experiencias reales
            </span>
            <div class="h-px w-12 bg-primary"></div>
          </div>
          <h2 class="text-5xl md:text-7xl lg:text-8xl font-heading text-surface-50 leading-[1.1]">
            Voces de nuestra <span class="text-primary font-heading">comunidad.</span>
          </h2>
        </div>
        <div class="max-w-xs mx-auto lg:mx-0">
          <p class="text-surface-50 text-lg font-body leading-relaxed border-l-2 border-primary pl-6 uppercase text-[14px] tracking-wide">
            Cientos de comensales han convertido nuestra mesa en su lugar favorito. Tu opinión es el motor de nuestra cocina.
          </p>
        </div>
      </div>
    </div>

    <!-- GRID DE TESTIMONIOS: BENTO PREMIUM -->
    <div class="grid md:grid-cols-1 lg:grid-cols-3 gap-8">
      {testimonials.map((t, index) => (
        <div 
          class="group relative p-10 bg-white rounded-[2.5rem] shadow-xl shadow-secondary/5 hover:shadow-2xl hover:shadow-primary/10 transition-all duration-500 animate-reveal flex flex-col border border-surface-100"
          style={`animation-delay: ${index * 150}ms`}
        >
          <!-- ICONO DE CITA ESTILIZADO -->
          <div class="absolute top-8 right-10 text-surface-100 group-hover:text-primary/10 transition-colors">
            <Quote className="w-16 h-16 fill-current" />
          </div>

          <!-- ESTRELLAS Y RATING -->
          <div class="flex gap-1 mb-8">
            {[...Array(t.rating)].map(() => (
              <Star className="w-4 h-4 fill-primary text-primary" />
            ))}
          </div>

          <!-- COMENTARIO -->
          <blockquote class="text-secondary/80 group-hover:text-secondary text-lg leading-relaxed mb-10 font-body flex-grow uppercase text-[15px] tracking-tight">
            "{t.text}"
          </blockquote>

          <!-- INFO COMENSAL -->
          <div class="pt-8 border-t border-surface-100 flex flex-col gap-4">
             <div class="flex items-center gap-3">
                 <div class="w-10 h-10 rounded-full bg-surface-50 flex items-center justify-center border border-surface-200 text-primary">
                    <Utensils className="w-5 h-5" />
                 </div>
                 <div class="flex flex-col">
                    <span class="text-[10px] uppercase font-bold tracking-[0.2em] text-primary">{t.dish}</span>
                    <span class="text-[9px] uppercase font-bold tracking-[0.1em] text-secondary/40">{t.experience}</span>
                 </div>
             </div>
             
             <cite class="not-italic">
                <span class="block text-secondary font-heading text-2xl uppercase tracking-wider">
                   {t.name}
                </span>
             </cite>
          </div>
        </div>
      ))}
    </div>

    <!-- FOOTER BLOCK: EL REFUERZO DE LA RESERVA -->
    <div class="mt-20 md:mt-32 p-1 md:p-1.5 bg-gradient-to-r from-transparent via-surface-300 to-transparent rounded-[3rem]">
        <div class="bg-surface-50 p-10 md:p-16 rounded-[2.8rem] flex flex-col lg:flex-row items-center justify-between gap-12 shadow-inner">
            
            <div class="flex flex-col lg:flex-row items-center gap-10">
               <!-- RATING DE GOOGLE REPLICA -->
               <div class="flex flex-col items-center bg-white p-6 rounded-3xl shadow-lg border border-surface-100">
                    <span class="text-4xl font-heading text-secondary leading-none mb-2">4.9</span>
                    <div class="flex gap-1 mb-3">
                        <Star className="w-3 h-3 fill-primary text-primary" />
                        <Star className="w-3 h-3 fill-primary text-primary" />
                        <Star className="w-3 h-3 fill-primary text-primary" />
                        <Star className="w-3 h-3 fill-primary text-primary" />
                        <Star className="w-3 h-3 fill-primary text-primary" />
                    </div>
                    <span class="text-[9px] font-bold uppercase tracking-widest text-secondary/40">RESEÑAS EN GOOGLE</span>
               </div>
               
               <div class="flex flex-col text-center lg:text-left">
                   <h3 class="text-secondary font-heading text-3xl leading-tight mb-4 uppercase">PLANIFIQUE SU VELADA</h3>
                   <p class="text-secondary/50 text-[12px] font-body uppercase tracking-wider max-w-sm">
                      RESERVE SU MESA CON ANTELACIÓN PARA GARANTIZAR LA MEJOR UBICACIÓN EN NUESTRO SALÓN PRINCIPAL.
                   </p>
               </div>
            </div>

            <div class="hidden lg:block h-24 w-px bg-surface-200"></div>

            <a href="#" class="group relative bg-surface-800 text-white rounded-full font-heading text-xl px-8 py-5 overflow-hidden transition-all hover:scale-105 active:scale-95 shadow-2xl shadow-secondary/20">
                <div class="relative z-10 flex items-center gap-4">
                  <CalendarCheck className="w-6 h-6 text-primary" />
                  <span class="uppercase tracking-[0.2em] font-bold">RESERVAR</span>
                </div>
                <!-- EFECTO GLOSS -->
                <div class="absolute inset-0 bg-white/5 -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
            </a>
        </div>
    </div>
  </div>
</section>

<style>
  .animate-reveal {
    opacity: 0;
    transform: translateY(30px);
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  blockquote {
    min-height: 5rem;
  }
</style>