---
import { Image } from "astro:assets";
import { Instagram, Sparkles, Utensils, ChefHat, GlassWater, ArrowUpRight } from "lucide-react";

// Importación de imágenes optimizadas
import proyect1 from "../../assets/galeria-1.jpg";
import proyect2 from "../../assets/galeria-2.jpg";
import proyect3 from "../../assets/galeria-3.jpg";
import proyect4 from "../../assets/galeria-4.jpg";
import proyect5 from "../../assets/galeria-5.jpg";
import proyect6 from "../../assets/galeria-6.jpg";

const moments = [
  { img: proyect1, title: "Nuestra Smash", category: "Cocina", size: "lg" },
  { img: proyect2, title: "Ambiente Nocturno", category: "Local", size: "md" },
  { img: proyect3, title: "Coctelería Autor", category: "Bar", size: "md" },
  { img: proyect4, title: "El Horno de Leña", category: "Técnica", size: "md" },
  { img: proyect5, title: "Ingredientes Bio", category: "Materia Prima", size: "md" },
  { img: proyect6, title: "Experiencia Gourmet", category: "Cocina", size: "lg" },
];
---

<section id="galeria" class="relative bg-surface-50 py-16 overflow-hidden">
  <div class="container relative z-10 mx-auto px-6 md:px-12">
    
    <!-- HEADER BLOCK: Estilo Editorial (Chapa Nueva) -->
    <div class="mb-12 md:mb-20 text-center lg:text-left animate-reveal">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-12">
        <div class="max-w-3xl">
          <div class="flex items-center justify-center lg:justify-start gap-4 mb-6">
             <div class="h-px w-12 bg-primary"></div>
            <span class="text-primary text-xs font-bold uppercase tracking-[0.4em]">
              Instagram Experience
            </span>
            <div class="h-px w-12 bg-primary"></div>
          </div>
          <h2 class="text-5xl md:text-7xl lg:text-8xl font-heading text-surface-800 leading-[1.1]">
            Más que Platos, <br />
            <span class="text-primary font-serif">Momentos.</span>
          </h2>
        </div>
        <div class="max-w-xs mx-auto lg:mx-0">
          <p class="text-surface-800/70 text-lg font-body leading-relaxed mb-6">
            "La cocina es un lenguaje mediante el cual se puede expresar armonía, felicidad y belleza."
          </p>
          <a href="#" class="flex items-center justify-center lg:justify-start gap-2 text-primary font-bold uppercase text-xs tracking-widest hover:translate-x-2 transition-transform">
             Síguenos en redes <Instagram className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

    <!-- GALLERY GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {moments.map((item, index) => (
        <div 
          class="group relative overflow-hidden rounded-2xl shadow-xl shadow-surface-800/5 bg-surface-800 animate-reveal" 
          style={`animation-delay: ${index * 100}ms`}
        >
          <!-- Contenedor de Imagen -->
          <div class="aspect-[4/5] lg:aspect-square overflow-hidden">
            <Image 
              src={item.img} 
              alt={item.title}
              class="w-full h-full object-cover transition-all duration-1000 group-hover:scale-110 group-hover:blur-[2px]"
            />
          </div>

          <!-- Overlay Elegante: Gradiente de color en lugar de fondo sólido -->
          <div class="absolute inset-0 bg-gradient-to-t from-surface-800/90 via-surface-800/20 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 p-8 flex flex-col justify-end">
             <div class="translate-y-8 group-hover:translate-y-0 transition-transform duration-500">
                <span class="inline-block px-3 py-1 border border-primary text-primary text-[10px] font-bold uppercase tracking-widest mb-4">{item.category}</span>
                <h3 class="text-white font-heading text-4xl mb-4 leading-none">{item.title}</h3>
                
                <div class="flex items-center gap-2 text-white/60 text-sm">
                   <Sparkles className="w-4 h-4 text-primary" />
                   <span>Ver Detalle</span>
                </div>
             </div>
          </div>

          <!-- Botón de acción flotante (Minimal) -->
          <div class="absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity translate-x-4 group-hover:translate-x-0 duration-500 delay-75">
             <div class="bg-primary p-3 rounded-full text-white shadow-xl shadow-primary/30">
                 <ArrowUpRight className="w-5 h-5" />
             </div>
          </div>
        </div>
      ))}
    </div>

    <!-- FOOTER BLOCK: Estilo Reserva (Más limpio) -->
    <div class="mt-20 p-1 bg-gradient-to-r from-transparent via-surface-300 to-transparent">
        <div class="bg-surface-50 py-12 flex flex-col lg:flex-row items-center justify-between gap-12 text-center lg:text-left">
            
            <div class="flex flex-col lg:flex-row items-center gap-8">
               <!-- Iconos en stack circular premium -->
               <div class="flex -space-x-4">
                   <div class="w-16 h-16 rounded-full border-4 border-surface-50 bg-primary flex items-center justify-center shadow-lg">
                        <Utensils className="text-white w-6 h-6" />
                   </div>
                   <div class="w-16 h-16 rounded-full border-4 border-surface-50 bg-surface-800 flex items-center justify-center shadow-lg">
                        <ChefHat className="text-white w-6 h-6" />
                   </div>
               </div>
               <div class="flex flex-col max-w-sm">
                   <span class="text-surface-800 font-heading text-3xl leading-none mb-2">El detalle hace la diferencia</span>
                   <span class="text-surface-800/60 text-sm font-body">Visítanos y descubre por qué somos el punto de encuentro favorito en la ciudad.</span>
               </div>
            </div>

            <div class="h-20 w-px bg-surface-300 hidden lg:block"></div>

            <a href="#reservas" class="relative group overflow-hidden bg-surface-800 text-white font-heading text-xl px-12 py-6 rounded-none transition-all hover:shadow-2xl hover:shadow-primary/20 transform hover:-translate-y-1">
                <span class="relative z-10 tracking-[0.2em] uppercase font-bold">Reserva tu mesa</span>
                <!-- Background slide effect -->
                <div class="absolute inset-0 bg-primary translate-y-[101%] group-hover:translate-y-0 transition-transform duration-300 ease-in-out"></div>
            </a>
        </div>
    </div>
  </div>
</section>

<style>
  .animate-reveal {
    opacity: 0;
    transform: translateY(30px);
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mejora de visualización de fotos foodie */
  img {
    filter: saturate(1.1) contrast(1.05);
  }
</style>