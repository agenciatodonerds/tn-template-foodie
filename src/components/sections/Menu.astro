---
import { Beef, Utensils, GlassWater, IceCream, Star, ChevronRight, Sparkles } from "lucide-react";

const menuCategories = [
  {
    id: "01",
    icon: Beef,
    title: "Cortes de Autor",
    desc: "Selección de carnes de pastura con 21 días de maduración. Cocción lenta a la leña para resaltar sabores primarios.",
    tags: ["Angus", "Madurado", "A la Cruz"]
  },
  {
    id: "02",
    icon: Utensils,
    title: "Burgers Gourmet",
    desc: "Blends de carne premium en pan brioche artesanal. Combinaciones únicas con quesos locales y vegetales orgánicos.",
    tags: ["Signature", "Handmade", "Smashed"]
  },
  {
    id: "03",
    icon: GlassWater,
    title: "Tragos & Craft",
    desc: "Mixología de autor y una selección curada de cervezas artesanales. El maridaje perfecto para cada plato.",
    tags: ["Mixología", "Tirada", "Botánicos"]
  },
  {
    id: "04",
    icon: IceCream,
    title: "Postres de Culto",
    desc: "El cierre dulce indispensable. Recetas clásicas reinterpretadas con técnicas de alta pastelería.",
    tags: ["Tentación", "Cacao 70%", "Clásicos"]
  },
];
---

<section id="menu" class="relative py-16 md:py-28 bg-surface-50 overflow-hidden">
  <div class="container relative z-10 mx-auto px-6 md:px-12">
    
    <!-- HEADER BLOCK: Estilo Editorial fluido -->
    <div class="mb-16 md:mb-24 animate-reveal text-center lg:text-left">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-12">
        <div class="max-w-3xl">
          <div class="flex items-center justify-center lg:justify-start gap-4 mb-6">
            <div class="h-px w-12 bg-primary"></div>
            <span class="text-primary text-xs font-bold uppercase tracking-[0.4em]">
              Sabor & Sabiduría
            </span>
            <div class="h-px w-12 bg-primary"></div>
          </div>
          <h2 class="text-5xl md:text-7xl lg:text-8xl font-heading text-surface-800 leading-[1.1]">
            Nuestra Carta <br />
            <span class="text-primary font-serif">Sin Artificios.</span>
          </h2>
        </div>
        <div class="max-w-xs mx-auto lg:mx-0">
          <p class="text-surface-800/70 text-lg font-body leading-relaxed border-l-2 border-primary/20 pl-6">
            Explora una propuesta gastronómica que respeta el origen y celebra la técnica perfecta en cada paso.
          </p>
        </div>
      </div>
    </div>

    <!-- GRID DE CATEGORÍAS: Bento Moderno sin bordes rígidos -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {menuCategories.map((item, index) => (
        <div 
          class="group relative p-10 bg-white rounded-3xl shadow-xl shadow-secondary/5 hover:shadow-2xl hover:shadow-primary/10 transition-all duration-500 animate-reveal flex flex-col min-h-[460px] border border-surface-100 overflow-hidden"
          style={`animation-delay: ${index * 150}ms`}
        >
          <!-- Efecto decorativo de fondo en Hover -->
          <div class="absolute top-0 left-0 w-full h-1 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
          
          <!-- ID Sutil -->
          <span class="absolute top-8 right-10 font-heading text-5xl text-surface-100 group-hover:text-primary/10 transition-colors">
            {item.id}
          </span>

          <!-- Icono con círculo suave -->
          <div class="mb-10 w-20 h-20 bg-surface-50 rounded-2xl flex items-center justify-center transition-all duration-500 group-hover:bg-primary group-hover:rotate-[10deg] shadow-inner">
             <item.icon className="text-primary group-hover:text-white w-10 h-10 transition-transform" />
          </div>

          <h3 class="text-3xl font-heading text-surface-800 mb-5 tracking-tight group-hover:text-primary transition-colors">
            {item.title}
          </h3>
          
          <p class="text-surface-800/70 text-[15px] leading-relaxed mb-8 font-body flex-grow">
            {item.desc}
          </p>

          <!-- Tags Minimalistas (Rounded full) -->
          <div class="flex flex-wrap gap-2 mb-10">
            {item.tags.map(tag => (
               <span class="text-[9px] uppercase font-bold bg-surface-50 px-3 py-1 rounded-full border border-surface-200 text-surface-800/50 group-hover:border-primary/30 group-hover:text-primary transition-all tracking-wider">
                  {tag}
               </span>
            ))}
          </div>

          <a href="#" class="flex items-center gap-3 text-surface-800 group-hover:text-primary font-bold text-xs uppercase tracking-[0.2em] transition-all">
             Explorar platos
             <div class="w-8 h-px bg-surface-800 group-hover:bg-primary group-hover:w-12 transition-all"></div>
          </a>
        </div>
      ))}
    </div>

    <!-- FOOTER BLOCK: Estilo Reserva (Minimal y Editorial) -->
    <div class="mt-20 md:mt-32 p-10 md:p-16 bg-surface-800 rounded-[2.5rem] relative overflow-hidden shadow-2xl animate-reveal">
        <!-- Decoración abstracta de fondo -->
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>

        <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12">
            <div class="flex flex-col lg:flex-row items-center gap-10">
               <div class="p-6 bg-primary/10 rounded-3xl backdrop-blur-sm border border-white/5">
                   <Star className="text-primary w-12 h-12 fill-primary" />
               </div>
               <div class="flex flex-col text-center lg:text-left">
                   <span class="text-white font-heading text-3xl leading-none mb-3">Materia Prima Premium</span>
                   <p class="text-primary text-sm font-heading max-w-xs leading-relaxed">
                    Proveedores locales certificados y trazabilidad en cada ingrediente.
                   </p>
               </div>
            </div>
            
            <div class="hidden lg:block h-24 w-px bg-white/10"></div>

            <div class="text-center lg:text-right">
              <p class="font-heading text-4xl md:text-4xl text-white mb-2 leading-none">
                De la huerta <span class="text-primary">a tu mesa</span>
              </p>
              <div class="flex items-center justify-center lg:justify-end gap-3 text-primary animate-pulse">
                <Sparkles className="w-5 h-5" />
                <span class="text-[10px] uppercase font-bold tracking-[0.4em]">Experiencia Unica</span>
              </div>
            </div>
        </div>
    </div>
  </div>
</section>

<style>
  .animate-reveal {
    opacity: 0;
    transform: translateY(30px);
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Smooth shadowing for high-end look */
  .shadow-xl {
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
  }
</style>