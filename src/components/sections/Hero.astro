---
import { Image } from "astro:assets";
import heroImage from "../../assets/hero-food.jpg";
import { Star, Clock, MapPin, Sparkles, StarIcon } from "lucide-react";
---

<section
  id="inicio"
  class="relative min-h-screen md:min-h-[100dvh] w-full flex items-center overflow-hidden bg-surface-950"
>
  <!-- 1. CAPA DE FONDO: Enfoque Inmersivo -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImage}
      alt="Experiencia gastronómica TodoNerds - Sabores Premium"
      class="w-full h-full object-cover opacity-50 scale-105 animate-subtle-zoom"
      widths={[720, 1280, 1920]}
      loading="eager"
      fetchpriority="high"
    />
    <!-- Overlay: Gradiente orgánico más suave -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-surface-950 via-surface-950/60 to-transparent"
    >
    </div>
  </div>

  <!-- 2. CONTENIDO: Editorial Flow -->
  <div class="container relative z-10 mx-auto px-6 md:px-12 pt-32 pb-16">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <!-- COLUMNA DERECHA: Contenido Principal -->
      <div class="lg:col-span-8 xl:col-span-8 lg:order-2">
        <!-- Badge de Status (Pill shape) -->
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 backdrop-blur-md border border-white/10 rounded-full text-white mb-8 animate-reveal"
        >
          <Sparkles className="w-3.5 h-3.5 text-primary fill-primary" />
          <span
            class="text-[10px] md:text-xs font-bold uppercase tracking-[0.3em]"
          >
            sabores de origen local
          </span>
        </div>

        <h1
          class="text-white text-6xl md:text-8xl lg:text-[110px] leading-[0.9] font-heading mb-8 animate-reveal [animation-delay:200ms] tracking-tighter"
        >
          Sabores que <br />
          <span class="text-bold" style="text-white">se disfrutan.</span><br />
          <span class="text-primary font-serif">Viví el momento.</span>
        </h1>

        <div
          class="grid md:grid-cols-1 lg:grid-cols-2 gap-8 items-start animate-reveal [animation-delay:400ms]"
        >
          <p
            class="text-white/60 text-lg md:text-xl font-body leading-relaxed max-w-md border-l-2 border-primary/40 pl-6"
          >
            Carne de pastura madurada, vegetales de huerta y coctelería de
            autor. Una experiencia para los sentidos en el corazón de la ciudad.
          </p>

          <div class="flex flex-col sm:flex-row gap-5 pt-4">
            <a
              href="#menu"
              class="relative group overflow-hidden bg-primary text-white font-heading text-xl px-12 py-5 transition-all shadow-2xl shadow-primary/20 text-center"
            >
              <span class="relative z-10 uppercase tracking-widest font-bold"
                >Ver Menú</span
              >
              <div
                class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-300 opacity-20"
              >
              </div>
            </a>
            <a
              href="#reservas"
              class="bg-transparent border border-white/20 hover:border-white text-white font-heading text-xl px-12 py-5 transition-all flex items-center justify-center backdrop-blur-sm"
            >
              RESERVAR
            </a>
          </div>
        </div>
      </div>

      <!-- COLUMNA IZQUIERDA: La "Ficha" Refactorizada (Chapa Nueva) -->
      <div
        class="lg:col-span-4 xl:col-span-4 lg:order-1 hidden lg:block animate-reveal [animation-delay:600ms]"
      >
        <div
          class="bg-white/5 backdrop-blur-xl border border-white/10 p-10 rounded-[3.5rem] relative overflow-hidden group shadow-2xl"
        >
          <!-- Círculos decorativos sutiles -->
          <div
            class="absolute -top-12 -right-12 w-32 h-32 bg-primary/10 rounded-full blur-2xl"
          >
          </div>

          <ul class="space-y-12">
            <li class="flex items-start gap-5">
              <div
                class="w-12 h-12 rounded-2xl bg-primary/20 flex items-center justify-center shrink-0 border border-primary/20"
              >
                <Clock className="text-primary w-6 h-6" />
              </div>
              <div class="flex flex-col">
                <span
                  class="text-white font-heading text-2xl tracking-tight leading-none"
                  >Abierto hoy</span
                >
                <span
                  class="text-white/40 text-[11px] font-bold uppercase tracking-[0.2em] mt-2"
                  >12:00 PM — 00:30 AM</span
                >
              </div>
            </li>

            <li class="flex items-start gap-5">
              <div
                class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center shrink-0 border border-white/10"
              >
                <MapPin className="text-primary w-6 h-6" />
              </div>
              <div class="flex flex-col">
                <span
                  class="text-white font-heading text-2xl tracking-tight leading-none"
                  >Cómo llegar</span
                >
                <span
                  class="text-white/40 text-[11px] font-bold uppercase tracking-[0.2em] mt-2"
                  >Distrito gourmet, calle 123</span
                >
              </div>
            </li>

            <li class="flex items-start gap-5">
              <div
                class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center shrink-0 border border-white/10"
              >
                <StarIcon className="text-primary w-6 h-6 fill-primary/20" />
              </div>
              <div class="flex flex-col">
                <span
                  class="text-white font-heading text-2xl tracking-tight leading-none"
                  >Reviews 4.9/5</span
                >
                <span
                  class="text-white/40 text-[11px] font-bold uppercase tracking-[0.2em] mt-2"
                  >+2000 experiencias</span
                >
              </div>
            </li>
          </ul>

          <div
            class="mt-14 pt-8 border-t border-white/5 flex items-center gap-4 text-white/40"
          >
            <Star className="w-4 h-4 fill-primary text-primary" />
            <span class="text-[9px] font-bold uppercase tracking-[0.4em]"
              >garantía de sabor premium</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- INDICADOR DE POSICIÓN: Más etéreo -->
  <div
    class="absolute right-8 top-1/2 -translate-y-1/2 hidden xl:flex flex-col items-center gap-10"
  >
    <span
      class="[writing-mode:vertical-lr] text-white/20 text-[10px] tracking-[0.6em] font-bold uppercase"
      >est. 2024</span
    >
    <div class="w-px h-24 bg-gradient-to-b from-primary/60 to-transparent">
    </div>
  </div>
</section>

<style>
  .animate-reveal {
    opacity: 0;
    transform: translateY(40px);
    animation: reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-subtle-zoom {
    animation: slowZoom 20s ease-in-out infinite alternate;
  }

  @keyframes slowZoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.1);
    }
  }

  /* Ajuste de brillo para legibilidad del Hero */
  img {
    filter: brightness(0.7) contrast(1.1);
  }
</style>
