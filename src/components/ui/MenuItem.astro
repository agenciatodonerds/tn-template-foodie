---
interface Props {
  title: string;
  price: string;
  description: string;
  tags?: string[];
  isFeatured?: boolean;
}

const { title, price, description, tags, isFeatured } = Astro.props;
---

<div
  class={`group flex flex-col gap-3 p-6 rounded-3xl transition-all duration-500 ${isFeatured ? "bg-primary/5 border border-primary/20" : "bg-white border border-surface-200"}`}
>
  <div class="flex justify-between items-start gap-4">
    <h4
      class="font-heading text-xl md:text-2xl text-secondary uppercase tracking-tight group-hover:text-primary transition-colors"
    >
      {title}
    </h4>
    <span class="font-heading text-xl text-primary shrink-0">{price}</span>
  </div>

  <p
    class="text-secondary/60 text-xs md:text-sm font-body leading-relaxed uppercase tracking-wider"
  >
    {description}
  </p>

  {
    tags && (
      <div class="flex flex-wrap gap-2 mt-auto pt-4">
        {tags.map((tag) => (
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-secondary/5 text-secondary/40 border border-secondary/10 uppercase tracking-widest">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</div>
